#!/usr/bin/env python3
"""Replay epi's recorded CLI streams; never contact a service or a model."""
import json
import os
import sys
from pathlib import Path

record = {"argv": sys.argv[1:], "cwd": os.getcwd(), "env": dict(os.environ),
          "stdin": sys.stdin.read()}
with open(os.environ["FAKE_EPI_RECORD"], "a") as file:
    file.write(json.dumps(record) + "\n")

fixtures = Path(__file__).resolve().parents[1] / "fixtures" / "harness"
tool = sys.argv[2]
scenario = os.environ.get("FAKE_EPI_SCENARIO", "change_completed")
if tool == "delegate" and scenario == "socket_down":
    text = (fixtures / "call_error_socket_down.txt").read_text()
    sys.stderr.write(text.split("stderr:\n", 1)[1].split("exit_code:", 1)[0])
    sys.exit(1)
if tool == "delegate" and scenario == "bad_output":
    print("test-token-canary is not JSON")
    sys.exit(1)
if tool == "delegate" and scenario == "no_receipt":
    print(json.dumps({"state": "completed", "phase": "done"}))
    sys.exit(0)
if tool == "delegate" and scenario == "ambiguous_error":
    sys.stderr.write("verification failed after acceptance\n")
    sys.exit(1)
if tool == "delegate" and scenario == "oversized":
    print("x" * 1_048_577)
    sys.exit(0)
if tool == "delegate":
    name = ("delegate_rejected_provider.json" if scenario == "rejected" else
            f"delegate_{scenario}.jsonl")
elif tool == "continue":
    name = "continue_completed.jsonl"
elif tool == "await":
    name = "await_after_approval.json"
else:
    name = f"{tool}.json"
text = (fixtures / name).read_text()
if tool == "list" and os.environ.get("FAKE_EPI_SCOPE"):
    value = json.loads(text)
    value["allowed_projects"] = [os.environ["FAKE_EPI_SCOPE"]]
    value["default_project"] = os.environ["FAKE_EPI_SCOPE"]
    text = json.dumps(value)
if tool == "await" and os.environ.get("FAKE_EPI_HUMAN_WAIT"):
    text = (fixtures / "delegate_awaiting_approval.jsonl").read_text().splitlines()[-1]
if tool == "await" and os.environ.get("FAKE_EPI_AWAIT_FAILED"):
    value = json.loads((fixtures / "delegate_failed_no_lane.jsonl").read_text().splitlines()[-1])
    value["run_id"] = sys.argv[sys.argv.index("--run-id") + 1]
    first = json.loads((fixtures / f"delegate_{scenario}.jsonl").read_text().splitlines()[0])
    value["agent_id"] = first["agent_id"]
    text = json.dumps(value)
if tool == "transcript":
    value = json.loads(text)
    value["run_id"] = sys.argv[sys.argv.index("--run-id") + 1]
    text = json.dumps(value)
if tool == "cancel":
    value = json.loads(text)
    value["agent_id"] = sys.argv[sys.argv.index("--agent-id") + 1]
    text = json.dumps(value)
sys.stdout.write(text + ("" if text.endswith("\n") else "\n"))
sys.stdout.flush()
if tool == "delegate" and os.environ.get("FAKE_EPI_EXIT_AFTER_ADMISSION"):
    sys.stderr.write("agent serve socket is unavailable\n")
    sys.exit(1)
